{
  "name": "lp-dr-helio-russo",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "deploy": "pnpm run build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "cf:dry-run": "pnpm run build && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:biome": "biome check .",
    "test": "vitest --config vitest.config.ts",
    "test:run": "pnpm run test:components && pnpm run test:infrastructure",
    "test:components": "vitest run --config vitest.config.ts --project components",
    "test:infrastructure": "vitest run --config vitest.config.ts --project infrastructure --passWithNoTests",
    "test:e2e": "playwright test",
    "validate": "pnpm run typecheck && pnpm run test:run && pnpm run check:biome && pnpm run build",
    "audit:css": "node scripts/audits/build/css-audit.mjs",
    "audit:bundle": "pnpm run build && node scripts/audits/build/bundle-audit.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/montserrat": "^5.2.8",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/intent": "^0.3.5",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "motion": "^12.42.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@cloudflare/vite-plugin": "^1.44.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/cli": "^0.69.5",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.1",
    "jsdom": "^28.1.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.110.0",
    "@playwright/test": "^1.61.1"
  },
  "packageManager": "pnpm@11.5.1",
  "description": "Landing page odontológica responsiva construída com TanStack Start, React, TypeScript, Tailwind CSS e Cloudflare Workers.",
  "license": "MIT",
  "homepage": "https://lp-dr-helio-russo.shyroe.workers.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shyroe/lp-dr-helio-russo.git"
  },
  "bugs": {
    "url": "https://github.com/Shyroe/lp-dr-helio-russo/issues"
  }
}
